DB_HOST=localhost
DB_USER=kkiri_app
DB_PASSWORD=replace-with-a-database-password
# 로컬 DB 최초 초기화에만 사용하며 운영 서버 계정과 분리합니다.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_NAME=myappdb
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_KEEP_ALIVE_DELAY_MS=10000

NODE_ENV=development
PORT=3000
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
ALLOW_LEGACY_USER_HEADER=false
LOG_LEVEL=info
ACTIVITY_CACHE_TTL_MS=30000
ACTIVITY_CACHE_MAX_ENTRIES=100
ACTIVITY_COMPATIBILITY_LIMIT=200
OPS_API_TOKEN=replace-with-a-random-operations-token
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
SCHOOL_EMAIL_DOMAINS=school.ac.kr,another.ac.kr
ALLOW_DUMMY_LOGIN=false

# 저비용 단일 서버 보호 설정. 프록시가 한 단계 앞에 있을 때만 1로 지정합니다.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
EMAIL_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=30
RATE_LIMIT_MAX_KEYS=10000

# 배포 주소 또는 이미지 CDN 주소입니다. 비우면 http://localhost:PORT를 사용합니다.
PUBLIC_MEDIA_BASE_URL=
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_SHUTDOWN_TIMEOUT_MS=10000

# API 서버가 여러 대면 오직 한 인스턴스에만 true를 설정합니다.
RUN_BACKGROUND_JOBS=true

# 이메일 인증/비밀번호 재설정 SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="끼리끼리 <no-reply@example.com>"

CRAWLER_USER_AGENT=kkiri-kkiri-crawler/1.0 (+https://github.com/C4t4ddict/kkiri-kkiri)
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_TIMEOUT_MS=15000
CRAWLER_RETRIES=3
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_PAGES=3
CRAWLER_LIMIT=50
CRAWLER_AUTO_ENABLED=true
CRAWLER_AUTO_INTERVAL_HOURS=6
CRAWLER_AUTO_INITIAL_DELAY_SECONDS=30
